# URL base do site (usada em canonical, OG, sitemap e robots).
# Em produção, defina o domínio final SEM barra no fim.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Verificação do Google Search Console (só o conteúdo de content="...").
# Opcional. Quando vazia, nenhuma meta tag é renderizada.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 (formato G-XXXXXXXXXX).
# Opcional. Sem valor, nenhum script é carregado.
# NEXT_PUBLIC_GA_ID=

# Google AdSense (formato ca-pub-XXXXXXXXXXXXXXXX).
# Opcional. Sem valor, nenhum script nem anúncio é renderizado.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Pexels usada apenas no servidor / scripts. Nunca exponha com NEXT_PUBLIC_.
# PEXELS_API_KEY=sua-chave-aqui
